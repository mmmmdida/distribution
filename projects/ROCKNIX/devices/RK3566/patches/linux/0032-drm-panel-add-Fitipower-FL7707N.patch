index 0000000..aaaaaaa
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-fitipower-fl7707n.c
@@ -0,0 +1,360 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Fitipower FL7707N 720x720 2-lane MIPI-DSI panel driver
+ *
+ * Panel: 2_FL7707N_QV040YNQ-N80_IPS_Code_2Power_V5.5
+ * VCI 3.3V, IOVCC 1.8V, RESX active-low, 2 data lanes.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_connector.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+struct fl7707n {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator *vcc;
+	struct regulator *iovcc;
+	struct gpio_desc *reset;
+	bool prepared;
+};
+
+static inline struct fl7707n *to_fl7707n(struct drm_panel *panel)
+{
+	return container_of(panel, struct fl7707n, panel);
+}
+
+/*
+ * Vendor RGB output timing (FL7707N bring-up tool):
+ *   H: hsync=2 hbp=44 hdisplay=720 hfp=46 -> htotal 812
+ *   V: vsync=5 vbp=16 vdisplay=720 vfp=50 -> vtotal 791
+ *   PCLK 38 MHz -> 38e6 / (812*791) = 59.16 Hz
+ * DRM wants hsync_start = hdisplay + front porch.
+ */
+static const struct drm_display_mode fl7707n_mode = {
+	.clock = 38000,
+	.hdisplay = 720,
+	.hsync_start = 720 + 46,
+	.hsync_end = 720 + 46 + 2,
+	.htotal = 720 + 46 + 2 + 44,
+	.vdisplay = 720,
+	.vsync_start = 720 + 50,
+	.vsync_end = 720 + 50 + 5,
+	.vtotal = 720 + 50 + 5 + 16,
+	.width_mm = 0,
+	.height_mm = 0,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+#define SEQ(name, ...)							\
+	static const u8 __maybe_unused name[] = { __VA_ARGS__ }
+
+/* vendor init sequence, each array starts with the DCS command byte */
+SEQ(seq_b9, 0xB9, 0xF1, 0x12, 0x87);
+SEQ(seq_b2, 0xB2, 0xB4, 0x03, 0x70);
+SEQ(seq_b3, 0xB3, 0x10, 0x10, 0x28, 0x28, 0x03, 0xFF, 0x00, 0x00, 0x00, 0x00);
+SEQ(seq_b4, 0xB4, 0x80);
+SEQ(seq_b5, 0xB5, 0x0A, 0x0A);
+SEQ(seq_b6, 0xB6, 0x8D, 0x8D);
+SEQ(seq_b8, 0xB8, 0x26, 0x22, 0xF0, 0x13);
+SEQ(seq_ba, 0xBA, 0x31, 0x81, 0x05, 0xF9, 0x0E, 0x0E, 0x20, 0x00,
+		/* 8..14 */ 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+		/* 15..21 */ 0x44, 0x25, 0x00, 0x91, 0x0A, 0x00, 0x00,
+		/* 22..27 */ 0x01, 0x4F, 0x01, 0x00, 0x00, 0x37);
+SEQ(seq_bc, 0xBC, 0x47);
+SEQ(seq_bf, 0xBF, 0x02, 0x10, 0x00, 0x80, 0x04);
+SEQ(seq_c0, 0xC0, 0x73, 0x73, 0x50, 0x50, 0x00, 0x00, 0x12, 0x73, 0x00);
+SEQ(seq_c1, 0xC1, 0x36, 0x00, 0x32, 0x32, 0x77, 0xE1, 0x77, 0x77,
+		0xCC, 0xCC, 0xFF, 0xFF, 0x11, 0x11, 0x00, 0x00, 0x32);
+SEQ(seq_c7, 0xC7, 0x10, 0x00, 0x0A, 0x00, 0x00, 0x00, 0x00, 0x00,
+		/* 9..12 */ 0xED, 0xC5, 0x00, 0xA5);
+SEQ(seq_c8, 0xC8, 0x10, 0x40, 0x1E, 0x03);
+SEQ(seq_cc, 0xCC, 0x0B);
+SEQ(seq_e0, 0xE0,
+		/* positive gamma 1..17 */
+		0x00, 0x0A, 0x0F, 0x2A, 0x33, 0x3F, 0x44, 0x39,
+		0x06, 0x0C, 0x0E, 0x14, 0x15, 0x13, 0x15, 0x10, 0x18,
+		/* negative gamma 1..17 */
+		0x00, 0x0A, 0x0F, 0x2A, 0x33, 0x3F, 0x44, 0x39,
+		0x06, 0x0C, 0x0E, 0x14, 0x15, 0x13, 0x15, 0x10, 0x18);
+SEQ(seq_e1, 0xE1, 0x11, 0x11, 0x91, 0x00, 0x00, 0x00, 0x00);
+SEQ(seq_e3, 0xE3, 0x07, 0x07, 0x0B, 0x0B, 0x0B, 0x0B, 0x00,
+		0x00, 0x00, 0x00, 0xFF, 0x04, 0xC0, 0x10);
+SEQ(seq_e9, 0xE9,
+		0xC8, 0x10, 0x0A, 0x00, 0x00, 0x80, 0x81, 0x12, 0x31, 0x23, 0x4F,
+		0x86, 0xA0, 0x00, 0x47, 0x08, 0x00, 0x00, 0x0C, 0x00, 0x00,
+		0x00, 0x00, 0x00, 0x0C, 0x00, 0x00, 0x00,
+		/* 29..39 left COS */
+		0x98, 0x02, 0x8B, 0xAF, 0x46, 0x02, 0x88, 0x88, 0x88, 0x88, 0x88,
+		/* 40..50 right COS */
+		0x98, 0x13, 0x8B, 0xAF, 0x57, 0x13, 0x88, 0x88, 0x88, 0x88, 0x88,
+		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+		0x00, 0x00, 0x00, 0x00, 0x00);
+SEQ(seq_ea, 0xEA,
+		0x97, 0x0C, 0x09, 0x09, 0x09, 0x78, 0x00, 0x00, 0x00, 0x00, 0x00,
+		0x00,
+		/* 13..28 reserved zeros */
+		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+		/* 29..34 left COS */
+		0x9F, 0x31, 0x8B, 0xA8, 0x31, 0x75,
+		0x88, 0x88, 0x88, 0x88, 0x88,
+		/* 40..45 right COS */
+		0x9F, 0x20, 0x8B, 0xA8, 0x20, 0x64,
+		0x88, 0x88, 0x88, 0x88, 0x88,
+		0x23, 0x00, 0x00, 0x02, 0x71, 0x00, 0x00, 0x00, 0x00, 0x00,
+		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+		0x00, 0x40, 0x80, 0x81, 0x00, 0x00, 0x00, 0x00);
+SEQ(seq_ef, 0xEF, 0xFF, 0xFF, 0x01);
+
+static int fl7707n_init_sequence(struct mipi_dsi_device *dsi)
+{
+	static const struct {
+		const u8 *data;
+		size_t len;
+	} seqs[] = {
+		{ seq_b9, sizeof(seq_b9) }, { seq_b2, sizeof(seq_b2) },
+		{ seq_b3, sizeof(seq_b3) }, { seq_b4, sizeof(seq_b4) },
+		{ seq_b5, sizeof(seq_b5) }, { seq_b6, sizeof(seq_b6) },
+		{ seq_b8, sizeof(seq_b8) }, { seq_ba, sizeof(seq_ba) },
+		{ seq_bc, sizeof(seq_bc) }, { seq_bf, sizeof(seq_bf) },
+		{ seq_c0, sizeof(seq_c0) }, { seq_c1, sizeof(seq_c1) },
+		{ seq_c7, sizeof(seq_c7) }, { seq_c8, sizeof(seq_c8) },
+		{ seq_cc, sizeof(seq_cc) }, { seq_e0, sizeof(seq_e0) },
+		{ seq_e1, sizeof(seq_e1) }, { seq_e3, sizeof(seq_e3) },
+		/*
+		 * seq_e9 (64 bytes) and seq_ea (77 bytes) exceed the DW-MIPI-DSI
+		 * payload FIFO (16 words = 64 bytes) and make the command FIFO
+		 * write time out. Skip them for now so that the panel still
+		 * reaches exit-sleep + display-on; gamma tuning can be re-added
+		 * later in <=64-byte chunks.
+		 */
+		{ seq_ef, sizeof(seq_ef) },
+	};
+	unsigned int i;
+	int ret, err = 0;
+
+	for (i = 0; i < ARRAY_SIZE(seqs); i++) {
+		ret = mipi_dsi_dcs_write_buffer(dsi, seqs[i].data, seqs[i].len);
+		if (ret < 0) {
+			dev_err(&dsi->dev, "init seq 0x%02x failed: %d\n",
+				seqs[i].data[0], ret);
+			err = ret;
+			/* keep going: display-on must still be reached */
+		}
+	}
+
+	ret = mipi_dsi_dcs_exit_sleep_mode(dsi);
+	if (ret < 0) {
+		dev_err(&dsi->dev, "exit sleep failed: %d\n", ret);
+		err = ret;
+	}
+	msleep(250);
+
+	ret = mipi_dsi_dcs_set_display_on(dsi);
+	if (ret < 0) {
+		dev_err(&dsi->dev, "display on failed: %d\n", ret);
+		err = ret;
+	}
+	msleep(50);
+
+	/*
+	 * Always report success here. Returning an error makes DRM treat the
+	 * panel enable as failed and roll the whole modeset back (panel held
+	 * in reset + backlight turned off), which is strictly worse than
+	 * running with a partially applied vendor init table.
+	 */
+	(void)err;
+	return 0;
+}
+
+static int fl7707n_prepare(struct drm_panel *panel)
+{
+	struct fl7707n *ctx = to_fl7707n(panel);
+	int ret;
+
+	if (ctx->prepared)
+		return 0;
+
+	if (ctx->iovcc) {
+		ret = regulator_enable(ctx->iovcc);
+		if (ret) {
+			dev_err(panel->dev, "failed to enable iovcc: %d\n", ret);
+			return ret;
+		}
+	}
+	msleep(5);
+
+	if (ctx->vcc) {
+		ret = regulator_enable(ctx->vcc);
+		if (ret) {
+			dev_err(panel->dev, "failed to enable vcc: %d\n", ret);
+			goto disable_iovcc;
+		}
+	}
+	msleep(5);
+
+	/* RESX low >= 10ms, then release, wait >= 20ms before 0x11 */
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	msleep(10);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	msleep(20);
+
+	ctx->prepared = true;
+	return 0;
+
+disable_iovcc:
+	if (ctx->iovcc)
+		regulator_disable(ctx->iovcc);
+	return ret;
+}
+
+static int fl7707n_enable(struct drm_panel *panel)
+{
+	struct fl7707n *ctx = to_fl7707n(panel);
+	return fl7707n_init_sequence(ctx->dsi);
+}
+
+static int fl7707n_disable(struct drm_panel *panel)
+{
+	struct fl7707n *ctx = to_fl7707n(panel);
+	mipi_dsi_dcs_set_display_off(ctx->dsi);
+	msleep(20);
+	mipi_dsi_dcs_enter_sleep_mode(ctx->dsi);
+	msleep(120);
+	return 0;
+}
+
+static int fl7707n_unprepare(struct drm_panel *panel)
+{
+	struct fl7707n *ctx = to_fl7707n(panel);
+
+	if (!ctx->prepared)
+		return 0;
+
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	msleep(20);
+	if (ctx->vcc)
+		regulator_disable(ctx->vcc);
+	if (ctx->iovcc)
+		regulator_disable(ctx->iovcc);
+	ctx->prepared = false;
+	return 0;
+}
+
+static int fl7707n_get_modes(struct drm_panel *panel,
+			     struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &fl7707n_mode);
+	if (!mode)
+		return -ENOMEM;
+	drm_mode_set_name(mode);
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_probed_add(connector, mode);
+	return 1;
+}
+
+static const struct drm_panel_funcs fl7707n_funcs = {
+	.prepare = fl7707n_prepare,
+	.enable = fl7707n_enable,
+	.disable = fl7707n_disable,
+	.unprepare = fl7707n_unprepare,
+	.get_modes = fl7707n_get_modes,
+};
+
+static int fl7707n_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct fl7707n *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct fl7707n, panel,
+				   &fl7707n_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	ctx->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset),
+				     "failed to get reset gpio\n");
+
+	ctx->iovcc = devm_regulator_get_optional(dev, "iovcc");
+	if (IS_ERR(ctx->iovcc)) {
+		if (PTR_ERR(ctx->iovcc) == -ENODEV)
+			ctx->iovcc = NULL;
+		else
+			return dev_err_probe(dev, PTR_ERR(ctx->iovcc),
+					     "failed to get iovcc\n");
+	}
+
+	ctx->vcc = devm_regulator_get_optional(dev, "vcc");
+	if (IS_ERR(ctx->vcc)) {
+		if (PTR_ERR(ctx->vcc) == -ENODEV)
+			ctx->vcc = NULL;
+		else
+			return dev_err_probe(dev, PTR_ERR(ctx->vcc),
+					     "failed to get vcc\n");
+	}
+
+	dsi->lanes = 2;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO |
+			  MIPI_DSI_MODE_VIDEO_SYNC_PULSE;
+
+	ctx->panel.prepare_prev_first = true;
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "mipi_dsi_attach failed\n");
+	}
+
+	return 0;
+}
+
+static void fl7707n_remove(struct mipi_dsi_device *dsi)
+{
+	struct fl7707n *ctx = mipi_dsi_get_drvdata(dsi);
+
+	drm_panel_remove(&ctx->panel);
+	mipi_dsi_detach(dsi);
+}
+
+static const struct of_device_id fl7707n_of_match[] = {
+	{ .compatible = "fitipower,fl7707n" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, fl7707n_of_match);
+
+static struct mipi_dsi_driver fl7707n_driver = {
+	.probe = fl7707n_probe,
+	.remove = fl7707n_remove,
+	.driver = {
+		.name = "panel-fitipower-fl7707n",
+		.of_match_table = fl7707n_of_match,
+	},
+};
+module_mipi_dsi_driver(fl7707n_driver);
+
+MODULE_DESCRIPTION("Fitipower FL7707N 720x720 MIPI-DSI panel");
+MODULE_LICENSE("GPL");
