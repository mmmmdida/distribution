#include "rk3566-powkiddy-x55.dts"

/ {
	model = "M1001";
	compatible = "powkiddy,m1001", "rockchip,rk3566";
};

/* 背光沿用 x55 结构，仅切换 PWM 通道到 pwm5 */
&backlight {
	pwms = <&pwm5 0 25000 0>;
};

&pwm5 {
	status = "okay";
};

/*
 * 面板复用内核自带的 himax-hx8394 驱动（chewitt 6.19 内核不提供 rocknix,generic-dsi），
 * 仅覆盖 M1001 定制板的复位脚与旋转方向；DCS 初始化序列由驱动内置。
 * 若 M1001 屏幕供电/复位时序与 x55 不同，请按原理图继续调整。
 */
&panel {
	compatible = "powkiddy,m1001-panel", "himax,hx8394";
	reset-gpios = <&gpio3 RK_PC3 GPIO_ACTIVE_LOW>;
	rotation = <0>;
};
