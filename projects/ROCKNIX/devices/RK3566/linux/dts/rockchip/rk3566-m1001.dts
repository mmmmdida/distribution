#include "rk3566-powkiddy-x55.dts"

/ {
	model = "M1001";
	compatible = "powkiddy,m1001", "rockchip,rk3566";
};

&backlight {
	pwms = <&pwm5 0 25000 0>;
};

&pwm5 {
	status = "okay";
};

&panel {
	compatible = "rocknix,generic-dsi";
	panel_description = "G size=70,52 delays=60,60,60,120,20 format=rgb888 lanes=2 flags=0xe03", "M clock=46115 horizontal=720,120,60,106 vertical=720,20,4,20 format=rgb888 lanes=2 default=1 # fps=60.000000", "I seq=11 wait=250", "I seq=29 wait=50";
	reset-gpios = <&gpio3 RK_PC3 GPIO_ACTIVE_LOW>;
	rotation = <0>;
};
